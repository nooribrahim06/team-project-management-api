# Local development and Prisma CLI connection.
# Use a PostgreSQL connection string supplied by your database provider.
NODE_ENV=development
HOST=localhost
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/team_project_management"

FRONTEND_URL="http://localhost:5173"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"
SESSION_EXPIRATION="30d"

# Optional in development. Required in production for verification emails.
EMAIL_USER=""
EMAIL_APP_PASSWORD=""
